/internet-swiatlowodowy-mragowo/ /mapa-sieci/        301
/internet-ketrzyn               /mapa-sieci/         301
/internet-ketrzyn/              /mapa-sieci/         301
/feed                           /aktualnosci/        301
/feed/                          /aktualnosci/        301
# pozostałe adresy WordPressa: kategorie, tagi, autorzy, kanały RSS wpisów
/category/*                     /aktualnosci/        301
/tag/*                          /aktualnosci/        301
/author/*                       /aktualnosci/        301
/comments/feed                  /aktualnosci/        301
/comments/feed/                 /aktualnosci/        301
/:slug/feed                     /:slug/              301
/:slug/feed/                    /:slug/              301
